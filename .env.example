# ──────────────────────────────────────────────────────────────────
# Speculon — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel for prod.
# ──────────────────────────────────────────────────────────────────

# Supabase project — hosted (Vercel) or local (`supabase start`)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable key (new format `sb_publishable_*`) OR legacy anon JWT.
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (new format `sb_secret_*`) OR legacy service_role JWT.
# Server-side ONLY. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# JWT secret for the app's own session cookie. Any random 32+ char string.
# Generate one: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-32-plus-random-chars
